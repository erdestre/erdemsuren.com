<?xml version="1.0" encoding="UTF-8"?>
<!--
  English pages (/en/...) get the English 404 page with a real 404 status.
  It lives in this folder so the relative File path is unambiguous (en\404.html, written by the prerender).
-->
<configuration>
  <system.webServer>
    <httpErrors errorMode="Custom" existingResponse="Replace">
      <remove statusCode="404" />
      <error statusCode="404" path="404.html" responseMode="File" />
    </httpErrors>
  </system.webServer>
</configuration>
