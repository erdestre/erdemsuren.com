<?xml version="1.0" encoding="UTF-8"?>
<!--
  erdemsuren.com as static files on IIS (URL Rewrite module). Every route is a prerendered dist/<path>/index.html.
  - No SPA catch-all rewrite: unknown paths must return a real 404 (dist/404.html, dist/en/404.html).
  - Redirect targets are absolute https:// URLs on the canonical host, whatever scheme a request arrives with.
  - Never add an X-Robots-Tag header: every page is meant to be indexed.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- Drop rules inherited from the server/site level, so no inherited fallback can turn unknown URLs into 200s. -->
        <clear />
        <!-- 1. www -> apex -->
        <rule name="Canonical host: www to apex" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTP_HOST}" pattern="^www\.erdemsuren\.com$" />
          </conditions>
          <action type="Redirect" url="https://erdemsuren.com/{R:1}" redirectType="Permanent" />
        </rule>

        <!-- 2. Legacy URLs of the old single-language site -->
        <rule name="Legacy: /aboutme" stopProcessing="true">
          <match url="^aboutme/?$" ignoreCase="true" />
          <action type="Redirect" url="https://erdemsuren.com/hakkimda/" redirectType="Permanent" appendQueryString="false" />
        </rule>
        <rule name="Legacy: /projects and /hosted" stopProcessing="true">
          <match url="^(?:projects|hosted)/?$" ignoreCase="true" />
          <action type="Redirect" url="https://erdemsuren.com/projeler/" redirectType="Permanent" appendQueryString="false" />
        </rule>
        <rule name="Legacy: /projectdetail/*" stopProcessing="true">
          <match url="^projectdetail(?:/.*)?$" ignoreCase="true" />
          <action type="Redirect" url="https://erdemsuren.com/projeler/" redirectType="Permanent" appendQueryString="false" />
        </rule>
        <rule name="Legacy: /contact" stopProcessing="true">
          <match url="^contact/?$" ignoreCase="true" />
          <action type="Redirect" url="https://erdemsuren.com/iletisim/" redirectType="Permanent" appendQueryString="false" />
        </rule>

        <!-- 3. Directory without trailing slash -> canonical slash form (instead of IIS' http:// courtesy redirect) -->
        <rule name="Directory: add trailing slash" stopProcessing="true">
          <match url="^(.*[^/])$" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" />
          </conditions>
          <action type="Redirect" url="https://erdemsuren.com/{R:1}/" redirectType="Permanent" />
        </rule>
      </rules>
      <outboundRules>
        <!-- Drop outbound rules inherited from the server/site level too: an inherited outbound rewrite of a
             response header would survive customHeaders/clear below. -->
        <clear />
      </outboundRules>
    </rewrite>

    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <!-- Real 404 status with the prerendered Turkish 404 page (English override in en/web.config).
         Only 404 is replaced here; other inherited error pages stay as they are. -->
    <!-- responseMode="File" keeps the 404 status (ExecuteURL would serve this static page with HTTP 200).
         Relative path = site root. English pages: dist/en/web.config overrides this with its own 404.html. -->
    <httpErrors errorMode="Custom" existingResponse="Replace">
      <remove statusCode="404" />
      <error statusCode="404" path="404.html" responseMode="File" />
    </httpErrors>

    <staticContent>
      <!-- Types a stock IIS may lack. Re-adding an existing type is HTTP 500.19, so each one is removed first. -->
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".avif" />
      <mimeMap fileExtension=".avif" mimeType="image/avif" />
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
      <!-- HTML, sitemap, robots, icons: always revalidate (Cache-Control: no-cache). Hashed /assets/ below. -->
      <clientCache cacheControlMode="DisableCache" />
    </staticContent>

    <httpProtocol>
      <customHeaders>
        <!-- <clear /> drops every inherited custom header (X-Powered-By, for example). Only this site's own
             headers follow. -->
        <clear />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="Permissions-Policy" value="camera=(), microphone=(), geolocation=()" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <!-- HSTS, set here because the clear above drops inherited headers. Browsers only accept it over HTTPS. -->
        <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains" />
        <!-- Report-only first: violations show in the browser console and nothing is blocked. Once every page is
             clean (contact form send included), rename the header to Content-Security-Policy. If Cloudflare Web
             Analytics is turned on, add https://static.cloudflareinsights.com to script-src and
             https://cloudflareinsights.com to connect-src. 'unsafe-inline' styles: React renders style="" attributes. -->
        <add name="Content-Security-Policy-Report-Only" value="default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://api.emailjs.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>

  <!-- Vite's content-hashed files: cache for a year, never revalidate. -->
  <location path="assets">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" cacheControlCustom="public, immutable" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
